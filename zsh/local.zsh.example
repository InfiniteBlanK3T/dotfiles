# Kubernetes — path to kubeconfig for this machine
# Uncomment and set the real path. Keep the quotes: < > are shell redirections.
# export KUBECONFIG="$HOME/.kube/config-<cluster-name>"

# BookStack Homelab remote management
export BOOKSTACK_TOKEN_ID=""
export BOOKSTACK_TOKEN_SECRET=""

